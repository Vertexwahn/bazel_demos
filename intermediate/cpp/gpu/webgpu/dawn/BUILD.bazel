load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "objc_library")

_CXX20 = select({
    "@platforms//os:windows": [
        "/std:c++20",
        "/Zc:__cplusplus",
        "/Zc:preprocessor",
    ],
    "//conditions:default": ["-std=c++20"],
})

alias(
    name = "dawn",
    actual = "@dawn_source//:webgpu_dawn",
)

objc_library(
    name = "metal_surface",
    srcs = ["metal_surface.mm"],
    hdrs = ["desktop_surface.h"],
    copts = ["-std=c++20"],
    sdk_frameworks = [
        "Cocoa",
        "QuartzCore",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":dawn",
        "@glfw",
    ],
)

cc_library(
    name = "desktop_surface",
    srcs = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["desktop_surface.cpp"],
    }),
    hdrs = ["desktop_surface.h"],
    copts = _CXX20,
    deps = [
        ":dawn",
        "@glfw",
    ] + select({
        "@platforms//os:macos": [":metal_surface"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "DawnDemoGlfw",
    srcs = ["main.cpp"],
    copts = _CXX20,
    linkopts = select({
        "@platforms//os:windows": [
            "user32.lib",
            "dxguid.lib",
            "onecore_apiset.lib",
        ],
        "@platforms//os:macos": [
            "-framework Metal",
            "-framework QuartzCore",
            "-framework IOSurface",
            "-framework IOKit",
        ],
        "//conditions:default": [
            "-ldl",
            "-lpthread",
        ],
    }),
    deps = [
        ":dawn",
        ":desktop_surface",
        "@glfw",
    ],
)

alias(
    name = "DawnDemo",
    actual = ":DawnDemoGlfw",
)

cc_binary(
    name = "index",
    srcs = ["main.cpp"],
    copts = ["-std=c++20"],
    linkopts = [
        "-sALLOW_MEMORY_GROWTH=1",
        "-sASSERTIONS=1",
    ],
    tags = ["manual"],
    deps = ["@emdawnwebgpu"],
)

wasm_cc_binary(
    name = "index-wasm-binary",
    cc_target = ":index",
    outputs = [
        "index-wasm/index.js",
        "index-wasm/index.wasm",
    ],
)

copy_file(
    name = "browser-shell",
    src = "index.html",
    out = "index-wasm/index.html",
)

filegroup(
    name = "index-wasm",
    srcs = [
        ":browser-shell",
        ":index-wasm-binary",
    ],
)
